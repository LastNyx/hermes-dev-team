{
 "permissions": {
  "defaultMode": "dontAsk",
  "allow": [
   "Read(./**)",
   "Glob",
   "Grep",
   "Edit(./**)",
   "Bash(git status)",
   "Bash(git status --short)",
   "Bash(git branch --show-current)",
   "Bash(git diff:*)",
   "Bash(git log:*)",
   "Bash(git add:*)",
   "Bash(git commit -m:*)"
  ],
  "deny": [
   "Edit(./.git/**)",
   "Edit(./.claude/**)",
   "Edit(./CONTEXT.md)",
   "Edit(./docs/adr/**)",
   "Edit(./docs/dev-notes.md)",
   "Edit(./.team.json)"
  ]
 },
 "includeCoAuthoredBy": false,
 "attribution": {
  "commit": "",
  "pr": ""
 }
}
